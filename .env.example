###############################################
# AI Studio Gemini Gateway
# 环境变量示例文件
#
# 说明：
# 1. 环境变量前缀统一为 AIGW_
# 2. 若 config.yaml 存在，则先加载文件，再用这些环境变量覆盖
# 3. 若 config.yaml 不存在，则程序会尝试基于环境变量生成有效配置
# 4. 纯数字 duration 按“秒”解释，例如：
#    - 30   -> 30s
#    - 300  -> 300s
# 5. 数组字段支持：
#    - 逗号分隔：a,b,c
#    - JSON 数组：["a","b","c"]
###############################################


###############################################
# server
###############################################

# 服务监听地址
# 容器/Render 环境请使用 0.0.0.0
AIGW_SERVER_HOST=0.0.0.0

# 服务监听端口
AIGW_SERVER_PORT=8080

# 读取请求超时
# 支持 30s / 30
AIGW_SERVER_READ_TIMEOUT=30

# 写响应超时
# 推荐流式场景使用 0 或 0s，表示不限制整体写时长
AIGW_SERVER_WRITE_TIMEOUT=0

# Idle timeout
AIGW_SERVER_IDLE_TIMEOUT=120

# 优雅关闭超时
AIGW_SERVER_SHUTDOWN_TIMEOUT=15

# 是否启用 TLS
# 一般在 Render / Nginx / Cloudflare 前置代理场景下保持 false
AIGW_SERVER_TLS_ENABLED=false

# TLS 证书路径（仅 TLS 启用时使用）
AIGW_SERVER_TLS_CERT_FILE=

# TLS 私钥路径（仅 TLS 启用时使用）
AIGW_SERVER_TLS_KEY_FILE=


###############################################
# access.http
###############################################

# 是否启用 HTTP API 鉴权
AIGW_ACCESS_HTTP_ENABLED=true

# HTTP API 访问密钥
# 可写单个值，也可多个逗号分隔
# 示例：
# AIGW_ACCESS_HTTP_KEYS=my-http-key
# AIGW_ACCESS_HTTP_KEYS=key1,key2
AIGW_ACCESS_HTTP_KEYS=replace-with-a-strong-http-api-key

# 是否允许 Authorization: Bearer <key>
AIGW_ACCESS_HTTP_ALLOW_BEARER=true

# 从哪些 Header 中提取 HTTP API key
AIGW_ACCESS_HTTP_HEADER_NAMES=X-Goog-Api-Key,X-Api-Key

# 从哪些 Query 参数中提取 HTTP API key
AIGW_ACCESS_HTTP_QUERY_NAMES=key,auth_token


###############################################
# access.cors
###############################################

# 是否启用 CORS
# 如果前端页面直接访问网关，请启用
AIGW_ACCESS_CORS_ENABLED=false

# 允许的 Origin 列表
# 示例：
# AIGW_ACCESS_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.example.com
AIGW_ACCESS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# 允许的方法
AIGW_ACCESS_CORS_ALLOWED_METHODS=GET,POST,OPTIONS

# 允许的请求头
AIGW_ACCESS_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Goog-Api-Key,X-Api-Key,X-Request-ID,X-Session-ID

# 允许前端读取的响应头
AIGW_ACCESS_CORS_EXPOSE_HEADERS=X-Request-ID,Retry-After

# 是否允许跨域携带凭据
AIGW_ACCESS_CORS_ALLOW_CREDENTIALS=false

# 预检缓存秒数
AIGW_ACCESS_CORS_MAX_AGE_SECONDS=600


###############################################
# websocket
###############################################

# Provider WebSocket 接入路径
AIGW_WEBSOCKET_PATH=/v1/ws

# WebSocket 握手超时
AIGW_WEBSOCKET_HANDSHAKE_TIMEOUT=10

# WebSocket 读取超时
AIGW_WEBSOCKET_READ_TIMEOUT=60

# WebSocket 写入超时
AIGW_WEBSOCKET_WRITE_TIMEOUT=10

# 单条 WS 消息最大字节数
# 默认 64 MiB
AIGW_WEBSOCKET_MAX_MESSAGE_SIZE=67108864

# 服务端 ping 间隔
AIGW_WEBSOCKET_HEARTBEAT_PING_INTERVAL=30

# 等待 pong 超时
AIGW_WEBSOCKET_HEARTBEAT_PONG_TIMEOUT=60


###############################################
# websocket.origin
###############################################

# Origin 校验模式：
# - any：允许任意 Origin（不推荐生产）
# - allow-missing：允许无 Origin；若有 Origin，则必须命中白名单
# - strict：必须携带 Origin 且必须命中白名单
AIGW_WEBSOCKET_ORIGIN_MODE=allow-missing

# 允许的 Provider 页面 Origin
# 支持：
# 1. 精确匹配，例如：
#    https://ai.studio
# 2. 通配符匹配，例如：
#    https://ais-pre-*.run.app
#
# 说明：
# 外部 Provider 页面虽然可能从 ai.studio / aistudio.google.com 打开，
# 但真正发起 WebSocket 的运行域通常是 ais-pre-*.run.app 这类托管域。
#
# 如果日志中出现：
#   wsrelay origin rejected
# 请优先把日志里的 origin 值补充到这里。
AIGW_WEBSOCKET_ORIGIN_ALLOWED_ORIGINS=https://aistudio.google.com,https://ai.studio,https://ais-pre-*.run.app,https://ais-dev-*.run.app


###############################################
# websocket.auth
###############################################

# 是否启用 WS Provider 鉴权
AIGW_WEBSOCKET_AUTH_ENABLED=true

# WS Provider 接入密钥
AIGW_WEBSOCKET_AUTH_KEYS=replace-with-a-strong-ws-api-key

# 是否允许 Authorization: Bearer <key>
AIGW_WEBSOCKET_AUTH_ALLOW_BEARER=true

# 从哪些 Header 中提取 WS key
AIGW_WEBSOCKET_AUTH_HEADER_NAMES=X-Goog-Api-Key,X-Api-Key

# 从哪些 Query 参数中提取 WS key
AIGW_WEBSOCKET_AUTH_QUERY_NAMES=key,auth_token


###############################################
# websocket.provider-identity
###############################################

# Provider ID 提取来源（Header）
AIGW_WEBSOCKET_PROVIDER_IDENTITY_ID_HEADER_NAMES=X-Provider-ID

# Provider ID 提取来源（Query）
AIGW_WEBSOCKET_PROVIDER_IDENTITY_ID_QUERY_NAMES=provider_id

# Provider Label 提取来源（Header）
AIGW_WEBSOCKET_PROVIDER_IDENTITY_LABEL_HEADER_NAMES=X-Provider-Label

# Provider Label 提取来源（Query）
AIGW_WEBSOCKET_PROVIDER_IDENTITY_LABEL_QUERY_NAMES=provider_label,label

# Provider Tags 提取来源（Header）
AIGW_WEBSOCKET_PROVIDER_IDENTITY_TAGS_HEADER_NAMES=X-Provider-Tags

# Provider Tags 提取来源（Query）
AIGW_WEBSOCKET_PROVIDER_IDENTITY_TAGS_QUERY_NAMES=provider_tags,tags

# Provider Priority 提取来源（Header）
AIGW_WEBSOCKET_PROVIDER_IDENTITY_PRIORITY_HEADER_NAMES=X-Provider-Priority

# Provider Priority 提取来源（Query）
AIGW_WEBSOCKET_PROVIDER_IDENTITY_PRIORITY_QUERY_NAMES=provider_priority,priority


###############################################
# routing
###############################################

# Provider 选路策略：
# - round_robin：轮询（默认推荐，最轻量）
# - fill_first：优先打满第一个可用 Provider
# - session_affinity：同一会话尽量固定到同一 Provider
AIGW_ROUTING_STRATEGY=round_robin

# Session affinity 保留时间
# 仅 session_affinity 策略下有意义
AIGW_ROUTING_SESSION_AFFINITY_TTL=1h

# Bootstrap 重试次数（首字节前）
# 流式请求在真正开始输出前，若 Provider 失败，可切换到其他 Provider 重试
AIGW_ROUTING_BOOTSTRAP_RETRIES=1

# Provider 冷却时间
# 当某个 Provider 临时失败、超时、429 或上游不可用时，会进入冷却期
AIGW_ROUTING_PROVIDER_COOLDOWN=300


###############################################
# models
###############################################

# 模型来源：
# - embedded：使用内置静态模型
# - custom：使用 config.yaml 中的 models.entries
#
# 注意：
# 当前环境变量方案仅支持设置 source，
# 不支持直接通过环境变量完整表达 models.entries / models.aliases。
AIGW_MODELS_SOURCE=embedded


###############################################
# gemini
###############################################

# Gemini API 版本
AIGW_GEMINI_API_VERSION=v1beta

# 默认 safetySettings 注入模式：
# - auto：当请求未显式给出 safetySettings 时自动补充
# - off：不自动补充
AIGW_GEMINI_SAFETY_DEFAULTS_MODE=auto

# Gemini image preview 兼容修复
# 适配 gemini-2.5-flash-image / gemini-2.5-flash-image-preview
AIGW_GEMINI_IMAGE_PREVIEW_COMPATIBILITY=true


###############################################
# gemini.thinking
###############################################

# thinking 模式：
# - auto：启用模型后缀 / 请求体 thinkingConfig 的统一处理
# - off：完全关闭 thinking 处理
AIGW_GEMINI_THINKING_MODE=auto

# 是否启用严格校验
# true：不合法 thinking 配置直接报错
# false：尽量兼容并自动降级
AIGW_GEMINI_THINKING_STRICT_VALIDATION=false


###############################################
# logging
###############################################

# 日志级别：
# debug / info / warn / error
AIGW_LOGGING_LEVEL=info

# 日志格式：
# text / json
# 容器平台建议 json，便于日志检索
AIGW_LOGGING_FORMAT=json

# 是否附带源码位置信息
AIGW_LOGGING_ADD_SOURCE=false

# 是否启用访问日志
# 轻量容器默认建议 false，除非确实需要排查请求
AIGW_LOGGING_ACCESS_LOG=false
